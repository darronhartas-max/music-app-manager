{
    "name": "music-app-manager",
    "version": "1.0.0",
    "description": "Music App Manager - Visual dashboard for launching music production apps and cataloging audio plugins",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "build": "electron-builder",
        "build:mac": "electron-builder --mac",
        "build:win": "electron-builder --win",
        "build:all": "electron-builder --mac --win"
    },
    "keywords": [
        "music",
        "audio",
        "plugins",
        "vst",
        "daw",
        "launcher",
        "electron"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "build": {
        "appId": "com.musicappmanager.app",
        "productName": "Music App Manager",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "renderer/**/*",
            "config/**/*",
            "assets/**/*"
        ],
        "mac": {
            "category": "public.app-category.music",
            "icon": "assets/icon.icns",
            "target": [
                "dmg",
                "zip"
            ]
        },
        "win": {
            "icon": "assets/icon.ico",
            "target": [
                "nsis",
                "portable"
            ]
        }
    }
}